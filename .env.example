# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Add these via the Settings panel to connect your real database!
# Both VITE_ prefixes and your existing NEXT_PUBLIC_ prefixes are supported!
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# VIZHINORG STANDALONE APP ROUTING:
# Set to 'false' to instantly rollback and re-enable local embedded VizhinORG inside this portal.
# Defaults to 'true' (shifts all ORG traffic to the standalone Remix VizhinORG project).
VITE_USE_STANDALONE_ORG="true"

# The URL of your standalone Remix VizhinORG project
VITE_VIZHIN_ORG_URL="https://ais-dev-w5xozbr56c6ysf2jdmwe3f-615362750641.us-west2.run.app"
