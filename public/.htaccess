# LiteSpeed / Apache DirectoryIndex and Access Configuration
DirectoryIndex index.html index.htm index.php

# Prevent directory browsing safely
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Directly allow sitemap.xml and robots.txt
  RewriteRule ^(sitemap\.xml|robots\.txt)$ - [L]

  # 2. Redirect uppercase /ORG to canonical /org/
  RewriteRule ^ORG/?$ /org/ [R=301,L]

  # 3. Existing static files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Fallback for static route subdirectories (e.g. /org/index.html)
  RewriteCond %{REQUEST_URI} ^/([^/]+)/?$
  RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
  RewriteRule ^ %1/index.html [L]

  # 5. SPA Fallback to root index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>

# Force correct Content-Types
<Files "sitemap.xml">
  ForceType application/xml
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=utf-8"
  </IfModule>
</Files>

<Files "robots.txt">
  ForceType text/plain
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
  </IfModule>
</Files>
